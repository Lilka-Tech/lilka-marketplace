{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://lilka.dev/schemas/marketplace-package-v1.json","type":"object","required":["schemaVersion","id","type","name","version","license","digest"],"properties":{"schemaVersion":{"const":1},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]+$"},"type":{"enum":["agent","agency","skill","appearance","tool","toolPack"]},"name":{"type":"string","minLength":1,"maxLength":200},"runtimeName":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,63}$"},"version":{"type":"string","minLength":1,"maxLength":100},"license":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"executor":{"type":"object","required":["type"],"properties":{"type":{"enum":["http","mcp","composition","script"]}},"additionalProperties":true},"inputSchema":{"type":"object"},"outputSchema":{"type":["object","null"]},"permissions":{"type":"object","required":["network","filesystem","subprocess","secrets","limits"]},"compatibility":{"type":"object"},"tools":{"type":"array","items":{"type":"object"}}},"allOf":[{"if":{"properties":{"type":{"const":"tool"}}},"then":{"required":["runtimeName","executor","inputSchema","permissions","compatibility"]}},{"if":{"properties":{"type":{"const":"toolPack"}}},"then":{"required":["tools","permissions","compatibility"]}}],"additionalProperties":true}
