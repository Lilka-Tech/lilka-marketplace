      "app": "#121214",
      "panel": "#18181b",
      "sidebar": "#18181b",
      "popover": "#222226"
    },
    "highlight": {
      "selection": "#1a3352",
      "focusRing": "#0070f3",
      "hover": "#1f1f23",
      "active": "#333338"
    },
    "semantic": {
      "success": "#22c55e",
      "warning": "#eab308",
      "danger": "#ef4444",
      "info": "#38bdf8"
    }
  },
  "editor": {
    "source": "lilka",
    "compatibility": {
      "vscodeTheme": true,
      "openVsx": true
    },
    "colors": {
      "editor.background": "#18181b",
      "editor.foreground": "#e8e8ea",
      "editor.selectionBackground": "#1e4976",
      "editor.lineHighlightBackground": "#1f1f23",
      "editorCursor.foreground": "#f4f4f5",
      "editor.findMatchBackground": "#0070f3"
    },
    "tokenColors": [],
    "codeSpace": {
      "gutter": "#18181b",
