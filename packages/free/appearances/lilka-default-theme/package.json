{
  "type": "theme",
  "version": "1.0.0",
  "marketplaceId": null,
  "name": "Lilka Default",
  "description": "Default Lilka appearance theme — deep charcoal surfaces, crisp zinc borders, and a vivid blue accent.",
  "tokens": {
    "--lk-bg": "#121214",
    "--lk-bg-2": "#18181b",
    "--lk-bg-3": "#222226",
    "--lk-panel": "#18181b",
    "--lk-border": "#333338",
    "--lk-border-strong": "#4a4a50",
    "--lk-fg": "#f4f4f5",
    "--lk-fg-2": "#b4b4b8",
    "--lk-fg-3": "#88888f",
    "--lk-fg-4": "#5c5c62",
    "--lk-accent": "#0070f3",
    "--lk-accent-2": "#3b9eff",
    "--lk-accent-soft": "#0a1f38",
    "--lk-ok": "#22c55e",
    "--lk-run": "#eab308",
    "--lk-err": "#ef4444",
    "--lk-info": "#38bdf8"
