  "background": {
    "type": "color",
    "value": "#fcfcfd",
    "image": null,
    "texture": null,
    "opacity": 1,
    "fit": "cover",
    "repeat": "no-repeat",
    "position": "center"
  },
  "ui": {
    "surface": {
      "app": "#fcfcfd",
      "panel": "#ffffff",
      "sidebar": "#f7f6f8",
      "popover": "#ffffff"
    },
    "highlight": {
      "selection": "#eee7f6",
      "focusRing": "#7651a8",
      "hover": "#f2eff4",
      "active": "#e7e3ea"
    },
    "semantic": {
      "success": "#247a4b",
      "warning": "#9a6700",
      "danger": "#c4322b",
      "info": "#176b87"
    }
  },
  "editor": {
    "source": "lilka",
    "compatibility": {
      "vscodeTheme": true,
      "openVsx": true
    },
    "colors": {
      "editor.background": "#ffffff",
      "editor.foreground": "#26232a",
      "editor.selectionBackground": "#ded0ee",
      "editor.lineHighlightBackground": "#f7f6f8",
      "editorCursor.foreground": "#654092",
      "editor.findMatchBackground": "#d9c5ef"
    },
    "tokenColors": [],
    "codeSpace": {
      "gutter": "#f7f6f8",
