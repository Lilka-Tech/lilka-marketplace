{
  "type": "theme",
  "version": "1.0.0",
  "marketplaceId": null,
  "name": "Lilka Light",
  "description": "Light Lilka appearance theme with crisp neutral surfaces and a focused lilac accent.",
  "tokens": {
    "--lk-bg": "#fcfcfd",
    "--lk-bg-2": "#f7f6f8",
    "--lk-bg-3": "#efedf2",
    "--lk-panel": "#ffffff",
    "--lk-border": "#dedbe3",
    "--lk-border-strong": "#c9c4d0",
    "--lk-fg": "#26232a",
    "--lk-fg-2": "#514b59",
    "--lk-fg-3": "#716979",
    "--lk-fg-4": "#8d8595",
    "--lk-accent": "#7651a8",
    "--lk-accent-2": "#654092",
    "--lk-accent-soft": "#eee7f6",
    "--lk-ok": "#247a4b",
    "--lk-run": "#9a6700",
    "--lk-err": "#c4322b",
    "--lk-info": "#176b87"
